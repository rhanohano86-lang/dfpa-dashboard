<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        DFPA Motor Vehicles
    </title>


    <style>

        :root {
            --dfpa-green: #2e7d32;
            --dfpa-blue: #33439a;
            --dfpa-yellow: #d8a900;
            --dfpa-red: #c62828;
            --dfpa-text: #222222;
            --dfpa-background: #ffffff;
        }


        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            padding: 0;
            background: transparent;
        }


        body {
            font-family:
                Arial,
                Helvetica,
                sans-serif;

            color:
                var(--dfpa-text);
        }


        .widget {
            width: 100%;
            max-width: 700px;
            margin: 0 auto;

            padding: 18px 20px;

            background:
                var(--dfpa-background);

            border: 4px solid
                var(--dfpa-yellow);

            border-radius: 8px;

            text-align: center;
        }


        .widget-title {
            margin: 0 0 8px;

            font-size: 14px;
            font-weight: 700;

            text-transform:
                uppercase;

            letter-spacing:
                0.04em;
        }


        .widget-level {
            margin: 0 0 8px;

            font-size: 24px;
            line-height: 1.35;

            font-weight: 700;
        }


        .widget-message {
            margin: 0;

            font-size: 20px;
            line-height: 1.4;

            font-weight: 700;
        }


        .widget.loading {
            border-color:
                var(--dfpa-blue);
        }


        .widget.low {
            border-color:
                var(--dfpa-green);
        }


        .widget.moderate {
            border-color:
                var(--dfpa-blue);
        }


        .widget.high {
            border-color:
                var(--dfpa-yellow);
        }


        .widget.extreme {
            border-color:
                var(--dfpa-red);
        }


        .widget.inactive {
            border-color:
                var(--dfpa-green);
        }


        @media (max-width: 600px) {

            .widget {
                padding: 15px 16px;
            }


            .widget-level {
                font-size: 21px;
            }


            .widget-message {
                font-size: 18px;
            }

        }

    </style>

</head>


<body>


    <section
        id="motorVehicleWidget"
        class="widget loading"
        aria-labelledby="widgetTitle"
    >

        <h1
            id="widgetTitle"
            class="widget-title"
        >
            Motor Vehicles
        </h1>


        <p
            id="widgetLevel"
            class="widget-level"
            role="status"
            aria-live="polite"
            aria-atomic="true"
        >
            Loading...
        </p>


        <p
            id="widgetMessage"
            class="widget-message"
            role="status"
            aria-live="polite"
            aria-atomic="true"
        >
            Loading current motor vehicle restrictions.
        </p>

    </section>


    <script>

        const widget =
            document.getElementById(
                "motorVehicleWidget"
            );


        const widgetLevel =
            document.getElementById(
                "widgetLevel"
            );


        const widgetMessage =
            document.getElementById(
                "widgetMessage"
            );


        const LEVEL_CONFIG = {

            LOW: {
                className:
                    "low",

                message:
                    "Allowed with Landowner Permission."
            },

            MODERATE: {
                className:
                    "moderate",

                message:
                    "Restricted at all times."
            },

            HIGH: {
                className:
                    "high",

                message:
                    "Restricted at all times."
            },

            EXTREME: {
                className:
                    "extreme",

                message:
                    "Restricted at all times."
            }

        };


        function setWidgetState(
            stateClass,
            levelText,
            restrictionText
        ) {

            widget.classList.remove(
                "loading",
                "low",
                "moderate",
                "high",
                "extreme",
                "inactive"
            );


            widget.classList.add(
                stateClass
            );


            widgetLevel.textContent =
                levelText;


            widgetMessage.textContent =
                restrictionText;


            widget.setAttribute(
                "aria-label",
                `Motor Vehicles: ${levelText}. ${restrictionText}`
            );

        }


        async function loadWidgetData() {

            try {

                const response =
                    await fetch(
                        "/api/public-status",
                        {
                            cache:
                                "no-store"
                        }
                    );


                if (
                    !response.ok
                ) {

                    throw new Error(
                        "Unable to load DFPA status."
                    );

                }


                const data =
                    await response.json();


                if (
                    !data.success
                ) {

                    throw new Error(
                        "Unable to load DFPA status."
                    );

                }


                /*
                 * Get the current effective
                 * Fire Danger level.
                 */

                const level =
                    String(
                        data
                            .current
                            ?.fire_restrictions
                            ?.level ||
                        ""
                    )
                        .toUpperCase()
                        .trim();


                const config =
                    LEVEL_CONFIG[level];


                if (!config) {

                    setWidgetState(
                        "moderate",
                        "Information unavailable.",
                        "Please check the current DFPA Fire Danger level."
                    );


                    return;
                }


                /*
                 * Display the current Fire Danger
                 * level and motor vehicle restriction.
                 */

                setWidgetState(
                    config.className,
                    level,
                    config.message
                );


            } catch (error) {

                console.error(
                    "DFPA motor vehicle widget error:",
                    error
                );


                setWidgetState(
                    "moderate",
                    "Information unavailable.",
                    "Please check the current DFPA Fire Danger level."
                );

            }

        }


        /*
         * Load once when the widget opens.
         */

        loadWidgetData();

    </script>


</body>

</html>
